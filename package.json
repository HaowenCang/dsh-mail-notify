{
  "name": "dsh-mail-notify",
  "version": "0.3.1",
  "description": "DeepSeek Harness plugin: email a top-level Agent turn's final output, its terminal failures, and its mid-turn human-attention requests over SMTP, configured from the Web UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:text": "node scripts/check-text-integrity.mjs",
    "pack:check": "node scripts/inspect-tarball.mjs",
    "scan:secrets": "node scripts/scan-tarball-secrets.mjs dsh-mail-notify-0.3.1.tgz",
    "probe:e2e": "node scripts/probe-e2e.mjs",
    "probe:questions": "node scripts/probe-e2e.mjs questions \"probe: question notification\"",
    "probe:errors": "node scripts/probe-e2e.mjs errors \"probe: terminal failure notification\"",
    "probe:approvals": "node scripts/probe-e2e.mjs approvals \"probe: approval notification\"",
    "probe:approvals-duplicate": "node scripts/probe-e2e.mjs approvals-duplicate \"probe: approval dedupe\"",
    "probe:approvals-rejected": "node scripts/probe-e2e.mjs approvals-rejected \"probe: approval rejected\"",
    "probe:credentials": "node scripts/probe-e2e.mjs credentials \"probe: credential contract\"",
    "smoke": "node scripts/smtp-smoke-test.ts",
    "verify": "npm run check:text && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "smtp",
    "nodemailer",
    "notification"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.4",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "jsdom": "^28.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.0",
    "typescript": "^5.9.3"
  }
}
