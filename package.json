{
  "name": "dsh-mail-notify",
  "version": "0.1.1",
  "description": "DeepSeek Harness host plugin: email the final user-visible output of a top-level Agent turn over SMTP.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:text": "node scripts/check-text-integrity.mjs",
    "pack:check": "node scripts/inspect-tarball.mjs",
    "smoke": "node scripts/smtp-smoke-test.ts",
    "verify": "npm run check:text && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "smtp",
    "nodemailer",
    "notification"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dependencies": {
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^7.0.12",
    "typescript": "^5.9.3"
  }
}
